{
  "name": "ebgeo-360-service",
  "version": "1.0.0",
  "description": "360 image service for EBGeo",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "generate-pmtiles": "node scripts/generate-pmtiles.js",
    "cleanup-wal": "node scripts/cleanup-wal.js",
    "test": "node --test tests/**/*.test.js",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:calibration": "eslint --no-ignore -c eslint-calibration.config.mjs public/calibration/js/*.js",
    "import-tracks": "node scripts/import-tracks.js",
    "derive-runs": "node scripts/derive-runs.js",
    "import-captured-at": "node scripts/import-captured-at.js",
    "bench": "node --env-file-if-exists=.env --expose-gc bench/banco.js",
    "bench:http": "node --env-file-if-exists=.env bench/http.js",
    "bench:cliente": "node --env-file-if-exists=.env bench/cliente.js"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.2.1",
    "geojson-vt": "^4.0.3",
    "sharp": "^0.33.5",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^15.15.0",
    "knip": "^5.83.1"
  },
  "author": "1º Centro de Geoinformação",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  }
}
